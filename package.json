{
  "name": "palavra-diaria",
  "version": "0.1.3",
  "description": "Mensagens bíblicas diárias",
  "main": "./out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "author": "Palavra Diária",
  "build": {
    "appId": "br.palavradiaria.app",
    "productName": "Palavra Diária",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/biblia/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Palavra-Diaria-Setup-${version}.exe",
      "shortcutName": "Palavra Diária"
    }
  }
}
